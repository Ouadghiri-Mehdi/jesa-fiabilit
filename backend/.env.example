# ── Base de données MySQL (XAMPP) ──────────────────────────────────────────
# Format : mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE?charset=utf8mb4
# XAMPP par défaut : root sans mot de passe, port 3306
DATABASE_URL=mysql+pymysql://root:@localhost:3306/jesa_fiabilite?charset=utf8mb4

# Si XAMPP a un mot de passe :
# DATABASE_URL=mysql+pymysql://root:monmotdepasse@localhost:3306/jesa_fiabilite?charset=utf8mb4

# ── JWT ────────────────────────────────────────────────────────────────────
# Clé secrète pour signer les tokens — changez-la en production !
SECRET_KEY=jesa-secret-key-change-in-production-2024

# ── IA (Groq) ───────────────────────────────────────────────────────────────
# Obtenez votre clé gratuite sur https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
